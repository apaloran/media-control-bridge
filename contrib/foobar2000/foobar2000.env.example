# Copy to ~/.config/media-control-bridge/foobar2000.env and edit.

# Wine prefix foobar2000 runs in (find it with the command in README.md).
WINEPREFIX=/home/YOU/.wine

# Wine binary. Use your Proton/Lutris/Bottles wine if foobar2000 runs under one.
WINE=wine

# Full Linux path to foobar2000.exe (Wine accepts Linux paths).
FOOBAR_EXE=/home/YOU/.wine/drive_c/Program Files/foobar2000/foobar2000.exe

# foo_beefweb address, used for title and play state. Leave empty to disable status.
BEEFWEB_URL=http://127.0.0.1:8880

# Bridge address (localhost only).
BRIDGE_LISTEN=127.0.0.1:17777
