[Unit]
Description=media-control-bridge MPRIS player for foobar2000
PartOf=graphical-session.target
After=graphical-session.target foobar2000-bridge.service
Wants=foobar2000-bridge.service

[Service]
ExecStart=%h/.local/bin/media-control-bridge mpris-client --connect 127.0.0.1:17777 --name foobar2000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
